from typing import Any

from app.forecasting.engine_adapter import load_forecasting_inputs, load_existing_engine


def get_product_forecast(product_id: int) -> dict[str, Any]:
    """
    Generate the existing forecasting engine's result for one product.
    """

    inputs = load_forecasting_inputs()

    monthly_df = inputs["monthly_df"]

    product_df = monthly_df[
        monthly_df["product_id"] == product_id
    ].copy()

    if product_df.empty:
        raise ValueError(f"Product {product_id} not found in sales data")

    engine = load_existing_engine()

    from src.sales_data import complete_product_series
    from src.pipeline import forecast_product

    global_end_month = monthly_df["month"].max()

    product_series = complete_product_series(
        product_df,
        end_date=global_end_month,
    )

    product_series["month"] = product_series["month"].astype("datetime64[ns]")
    product_series = (
        product_series
        .sort_values("month")
        .reset_index(drop=True)
    )

    stock_on_hand = inputs["stock_map"].get(product_id, 0.0)

    result = forecast_product(
        product_series,
        test_size=6,
        season_length=12,
        stock_on_hand=stock_on_hand,
    )

    product_name = product_df["product_name"].dropna()

    return {
        "product_id": product_id,
        "product_name": (
            product_name.iloc[0]
            if not product_name.empty
            else None
        ),
        **result,
    }